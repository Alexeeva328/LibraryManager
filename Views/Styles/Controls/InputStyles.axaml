<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================== -->
    <!-- 1. СТИЛЬ ДЛЯ ТЕКСТОВОГО ПОЛЯ (TextBox)   -->
    <!-- ======================================== -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- ======================================== -->
    <!-- 2. СТИЛЬ ДЛЯ ВЫПАДАЮЩЕГО СПИСКА (ComboBox) -->
    <!-- ======================================== -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Стиль для элементов внутри выпадающего списка -->
    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource CardHoverBackgroundBrush}" />
    </Style>

    <!-- ======================================== -->
    <!-- 3. СТИЛЬ ДЛЯ ПОЛЯ ПОИСКА (Watermark)      -->
    <!-- ======================================== -->
    <!-- Если используете Avalonia UI, у TextBox есть свойство Watermark -->
    <Style Selector="TextBox.SearchBox">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="CornerRadius" Value="20" /> <!-- Скругленный поиск -->
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ======================================== -->
    <!-- 4. СТИЛЬ ДЛЯ ЧЕКБОКСА (CheckBox)         -->
    <!-- ======================================== -->
    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ======================================== -->
    <!-- 5. СТИЛЬ ДЛЯ ПОЛЯ ВВОДА ЧИСЕЛ (NumericUpDown) -->
    <!-- ======================================== -->
    <Style Selector="NumericUpDown">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- ======================================== -->
    <!-- 6. СТИЛЬ ДЛЯ ВЫБОРА ДАТЫ (DatePicker)    -->
    <!-- ======================================== -->
    <Style Selector="DatePicker">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Фон для календаря, который выпадает -->
    <Style Selector="DatePickerPresenter">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

</Styles>