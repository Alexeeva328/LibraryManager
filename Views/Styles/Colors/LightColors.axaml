<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <SolidColorBrush x:Key="BackgroundBrush">#F8F9FA</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackgroundBrush">#F0F0F0</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush">#F5F5F5</SolidColorBrush>
    
    <SolidColorBrush x:Key="PrimaryTextBrush">#1A1A1E</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryTextBrush">#6A6A6A</SolidColorBrush>
    <SolidColorBrush x:Key="InvertedTextBrush">#FFFFFF</SolidColorBrush>
    
    <SolidColorBrush x:Key="BorderBrush">#DDDDDD</SolidColorBrush>
    <SolidColorBrush x:Key="SeparatorBrush">#E5E5E5</SolidColorBrush>
    
    <SolidColorBrush x:Key="InputBackgroundBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="InputBorderBrush">#CCCCCC</SolidColorBrush>
    <SolidColorBrush x:Key="InputForegroundBrush">#1A1A1E</SolidColorBrush>
    
</ResourceDictionary>