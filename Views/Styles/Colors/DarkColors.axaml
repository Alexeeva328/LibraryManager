<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Переопределяем ресурсы для тёмной темы -->
    <SolidColorBrush x:Key="BackgroundBrush">#1A1A1E</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackgroundBrush">#25252B</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush">#2D2D35</SolidColorBrush>
    <SolidColorBrush x:Key="CardHoverBackgroundBrush">#3A3A44</SolidColorBrush>
    
    <SolidColorBrush x:Key="PrimaryTextBrush">#E8E8E8</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryTextBrush">#9A9A9A</SolidColorBrush>
    <SolidColorBrush x:Key="InvertedTextBrush">#1A1A1E</SolidColorBrush>
    
    <SolidColorBrush x:Key="BorderBrush">#3A3A44</SolidColorBrush>
    <SolidColorBrush x:Key="SeparatorBrush">#3A3A44</SolidColorBrush>
    
    <SolidColorBrush x:Key="InputBackgroundBrush">#2D2D35</SolidColorBrush>
    <SolidColorBrush x:Key="InputBorderBrush">#4A4A55</SolidColorBrush>
    <SolidColorBrush x:Key="InputForegroundBrush">#E8E8E8</SolidColorBrush>
    
</ResourceDictionary>